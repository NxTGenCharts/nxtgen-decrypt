# Copy to .env and fill in for your deployment.

# Port the proxy listens on.
PORT=8787

# Comma-separated list of front-end origins allowed to call this proxy.
# In production this should be your real site, not "*".
# Example: ALLOWED_ORIGIN=https://nxtgendecrypt.site
ALLOWED_ORIGIN=*

# --- Accounts (optional) — see README "Accounts" ---
# Public/publishable key from Supabase → Project Settings → API Keys. Enables sign-in.
# (BOT_SUPABASE_URL, BOT_SUPABASE_KEY and BOT_VAULT_KEY are the same ones the 24/7 bots already use.)
SUPABASE_ANON_KEY=
# Invite-only: comma-separated emails and/or @domains. Leave empty to allow any confirmed account.
ALLOWED_EMAILS=
# Accounts the server will run at once (each has its own bot loop).
BOT_MAX_USERS=25
# true = refuse the old shared WORKER_TOKEN for bots once everyone has moved to accounts.
ACCOUNTS_REQUIRED=false
