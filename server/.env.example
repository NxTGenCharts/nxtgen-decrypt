# Copy to .env and fill in for your deployment.

# Port the proxy listens on.
PORT=8787

# Comma-separated list of front-end origins allowed to call this proxy.
# In production this should be your real site, not "*".
# Example: ALLOWED_ORIGIN=https://nxtgendecrypt.site
ALLOWED_ORIGIN=*

# ---- 24/7 worker (all optional except WORKER_TOKEN; see README "Access tokens, saved settings and auto-arm")
# Set these in the host's Environment settings (Render), not in a committed file.
# WORKER_TOKEN=<at least 20 random characters>
# WORKER_VIEW_TOKEN=<optional read-only token, 20+ chars>
# WORKER_EXCHANGE=bybit
# WORKER_MODE=demo
# WORKER_API_KEY=
# WORKER_SECRET_KEY=
# WORKER_PASSPHRASE=
# WORKER_AUTOARM=true
